{
  "name": "infohub-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "backend:install": "npm --prefix backend install",
    "backend:build": "npm --prefix backend run build",
    "backend:dev": "npm --prefix backend run dev",
    "postinstall": "npm run backend:install",
    "dev:all": "concurrently -n FRONT,BACK -c blue,green \"npm run dev\" \"npm run backend:dev\"",
    "build:all": "vite build && npm run backend:build",
    "start": "npm run build:all && npm --prefix backend run start"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
