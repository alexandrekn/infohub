PORT=3333
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# String de conexão do PostgreSQL local.
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infohub"

# Schema exclusivo da dupla no banco compartilhado do professor.
# Use exatamente o nome fornecido pelo professor/Coolify.
DB_SCHEMA=infohub_dupla

# RF-17/18/19/20 — e-mail transacional via Resend. Sem essa chave, os
# e-mails só são registrados no console (modo simulado) — nada quebra.
# Crie uma conta grátis em https://resend.com, gere uma API key e cole aqui.
RESEND_API_KEY=
# Remetente. Sem domínio verificado no Resend, use o padrão de testes deles
# (só envia para o e-mail da própria conta Resend). Com domínio verificado,
# troque para algo como "InfoHub <contato@seudominio.com>".
RESEND_FROM_EMAIL="InfoHub <onboarding@resend.dev>"

# Link usado dentro dos e-mails ("Acessar o InfoHub").
APP_URL=http://localhost:5173

# De quantos em quantos minutos o backend confere lembretes pendentes e
# tarefas com prazo vencido (RF-17/18 e RN-04).
INTERVALO_LEMBRETES_MIN=60
